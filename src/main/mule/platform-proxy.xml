<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:os="http://www.mulesoft.org/schema/mule/os" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:anypoint-mq="http://www.mulesoft.org/schema/mule/anypoint-mq"
	xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/anypoint-mq http://www.mulesoft.org/schema/mule/anypoint-mq/current/mule-anypoint-mq.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
	<flow name="pf-platform-get-user-orgs-impl" doc:id="platform-flow-orgs-0001" >
		<http:listener doc:name="Get user orgs" doc:id="platform-listener-orgs-0001" config-ref="HTTP_Listener_config" path="/platform/me" allowedMethods="GET"/>
		<flow-ref doc:name="Resolve bearer token" doc:id="platform-resolve-orgs-0001" name="sf-resolve-bearer-token"/>
		<http:request method="GET" doc:name="Call Anypoint /accounts/api/me" doc:id="platform-request-me-0001" config-ref="Anypoint_Platform_Request_Config" path="${anypointPlatform.accounts.me}">
			<http:headers><![CDATA[#[output application/java --- {"Authorization": vars.resolvedAuthorization}]]]></http:headers>
		</http:request>
	</flow>
	<flow name="pf-platform-get-environments-impl" doc:id="platform-flow-envs-0001" >
		<http:listener doc:name="Get environments" doc:id="platform-listener-envs-0001" config-ref="HTTP_Listener_config" path="/platform/organizations/{orgId}/environments" allowedMethods="GET"/>
		<flow-ref doc:name="Resolve bearer token" doc:id="platform-resolve-envs-0001" name="sf-resolve-bearer-token"/>
		<http:request method="GET" doc:name="Call Anypoint environments" doc:id="platform-request-envs-0001" config-ref="Anypoint_Platform_Request_Config" path='#["${anypointPlatform.accounts.organizations}" replace "{orgId}" with attributes.uriParams.orgId]'>
			<http:headers><![CDATA[#[output application/java --- {"Authorization": vars.resolvedAuthorization}]]]></http:headers>
		</http:request>
	</flow>
	<flow name="pf-platform-get-regions-impl" doc:id="platform-flow-regions-0001" >
		<http:listener doc:name="Get MQ regions" doc:id="platform-listener-regions-0001" config-ref="HTTP_Listener_config" path="/platform/organizations/{orgId}/environments/{envId}/regions" allowedMethods="GET"/>
		<flow-ref doc:name="Resolve bearer token" doc:id="platform-resolve-regions-0001" name="sf-resolve-bearer-token"/>
		<http:request method="GET" doc:name="Call Anypoint MQ regions" doc:id="platform-request-regions-0001" config-ref="Anypoint_Platform_Request_Config" path='#["${anypointPlatform.mq.admin.regions}" replace "{orgId}" with attributes.uriParams.orgId replace "{envId}" with attributes.uriParams.envId]'>
			<http:headers><![CDATA[#[output application/java --- {"Authorization": vars.resolvedAuthorization}]]]></http:headers>
		</http:request>
	</flow>
	<flow name="pf-platform-get-destinations-impl" doc:id="platform-flow-dests-0001" >
		<http:listener doc:name="Get MQ destinations" doc:id="platform-listener-dests-0001" config-ref="HTTP_Listener_config" path="/platform/organizations/{orgId}/environments/{envId}/regions/{regionId}/destinations" allowedMethods="GET"/>
		<flow-ref doc:name="Resolve bearer token" doc:id="platform-resolve-dests-0001" name="sf-resolve-bearer-token"/>
		<http:request method="GET" doc:name="Call Anypoint MQ destinations" doc:id="platform-request-dests-0001" config-ref="Anypoint_Platform_Request_Config" path='#["${anypointPlatform.mq.admin.destinations}" replace "{orgId}" with attributes.uriParams.orgId replace "{envId}" with attributes.uriParams.envId replace "{regionId}" with attributes.uriParams.regionId]'>
			<http:headers><![CDATA[#[output application/java --- {"Authorization": vars.resolvedAuthorization}]]]></http:headers>
		</http:request>
	</flow>
	<flow name="pf-platform-get-connected-apps-impl" doc:id="platform-flow-apps-0001" >
		<http:listener doc:name="Get connected apps" doc:id="platform-listener-apps-0001" config-ref="HTTP_Listener_config" path="/platform/connected-apps" allowedMethods="GET"/>
		<flow-ref doc:name="Resolve bearer token" doc:id="platform-resolve-apps-0001" name="sf-resolve-bearer-token"/>
		<http:request method="GET" doc:name="Call Anypoint connected apps" doc:id="platform-request-apps-0001" config-ref="Anypoint_Platform_Request_Config" path="${anypointPlatform.connectedApps}">
			<http:headers><![CDATA[#[output application/java --- {"Authorization": vars.resolvedAuthorization}]]]></http:headers>
		</http:request>
	</flow>
</mule>
